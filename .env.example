# Vorlage für die lokale .env
# 1. Datei kopieren:  cp .env.example .env   (Windows: copy .env.example .env)
# 2. Eigene, sichere Passwörter eintragen
# 3. .env NIEMALS committen (steht in .gitignore)

# Datenbank (MariaDB)
DB_NAME=wordpress
DB_USER=wp_user
DB_PASSWORD=bitte_aendern
DB_ROOT_PASSWORD=bitte_aendern_root

# WordPress
WP_TABLE_PREFIX=wp_
WP_DEBUG=1

# Ports auf dem Host
WP_PORT=8080
PMA_PORT=8081
